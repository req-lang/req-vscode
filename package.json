{
  "name": "req-vscode",
  "displayName": "req-lang",
  "description": "Language support for the req",
  "version": "0.1.0",
  "author": "Sami Dahoux <sami@qitab.io>",
  "license": "See LICENSE",
  "publisher": "Qitab",
  "engines": {
    "vscode": "^1.78.1"
  },
  "scripts": {
    "grammars": "node scripts/build.js"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "req",
        "aliases": [
          "req",
          "req"
        ],
        "extensions": [
          ".req"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "req",
        "scopeName": "source.req",
        "path": "./syntaxes/req.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "req.restartServer",
        "title": "req: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "req",
      "properties": {
        "req.lsp.path": {
          "type": "string",
          "default": "reqlsp",
          "markdownDescription": "Language server executable. Looked up in `PATH` unless an absolute path is given."
        },
        "req.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the LSP communication in the 'req Language Server' output channel."
        }
      }
    }
  },
  "devDependencies": {
    "js-yaml": "^4.1.1"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:req"
  ]
}
